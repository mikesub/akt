# Secrets
# Optional. With it, the CLI below bills the Anthropic API; without it, the
# CLI uses its own logged-in session. Confirm which of the two your plan
# permits for unattended use before running from cron.
# ANTHROPIC_API_KEY=

# Path to the SQLite database. Default: ./akt.db
AKT_DB=./akt.db

# Podcast feed start URL. The canonical URL is resolved from
# <itunes:new-feed-url> and stored in meta.feed_url.
AKT_FEED_URL=https://cloud.mave.digital/61003

# Where episode audio is kept. Default: ./media
AKT_MEDIA_DIR=./media

# Keep the MP3 and the decoded WAV after an episode is past `transcribed`.
# Unset (the default) deletes them: ~4.6 GB of MP3s plus ~10 GB of WAVs for
# the whole archive, and the enclosure is always re-downloadable.
# KEEP_MEDIA=1

# The ffmpeg binary used to decode the MP3 to 16 kHz mono PCM WAV.
AKT_FFMPEG=ffmpeg

# Which locally installed LLM CLI the adapter drives: claude | codex.
LLM_CLI=claude

# Seconds one LLM call may take before it is killed, so a hung CLI cannot
# stall a cron run.
LLM_TIMEOUT=120

# The whisper.cpp binary that transcribes each episode. A name on PATH or a
# path to the build output.
WHISPER_CLI=whisper-cli

# The ggml model, chosen once by hand: no automatic fallback. The README has a
# 3-minute benchmark; if large-v3 cannot finish an episode's speech inside
# WHISPER_TIMEOUT on this box, set large-v3-turbo here and leave it.
WHISPER_MODEL=large-v3

# Where ggml-<model>.bin and ggml-silero-v5.1.2.bin live. Both are downloaded
# once by hand (see README); the pipeline never fetches them.
WHISPER_MODEL_DIR=./models

# Seconds one episode may spend in whisper-cli before it is killed.
WHISPER_TIMEOUT=3600

# Threads whisper.cpp may use. Unset lets it decide.
# WHISPER_THREADS=
